// Cloudflare Workers: the web app (dist/, npm run build:cloudflare) at the root
// of conoxxo.<cuenta>.workers.dev. It has no Cloudflare Access: everyone signs
// in with their employee number and PIN, as on GitHub Pages.
// /DashboardsOxxo/* goes through worker/index.js to the dashboards Worker
// (service binding, so Access does not apply) for the Ficha de Plaza of the
// "Resumen" tab and the store catalog CSV only. /admin goes to the Conoxxo
// panel, which now lives with the dashboards' Panel Admin (behind Access).
{
  "name": "conoxxo",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/DashboardsOxxo/*", "/assets/node_modules/*", "/admin", "/admin/*", "/api/*"]
  },
  // Chat prototype (worker/chat.js): Workers AI, only for these employee
  // numbers until it is opened to everyone. The model can be changed here.
  "ai": { "binding": "AI" },
  "vars": {
    "CHAT_IA_NUMEROS": "*",
    "CHAT_IA_MODELO": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CHAT_IA_LIMITE_DIA": "40",
    // "auto": Claude Haiku 5.5 when the ANTHROPIC_API_KEY secret is set
    // (worker/claude.js), else Workers AI. Or "haiku" / "workers-ai".
    "CHAT_IA_PROVEEDOR": "auto",
    "DATOS_IA_NUMEROS": "5843652,1599067",
    "DATOS_IA_LIMITE_DIA": "30"
  },
  "services": [{ "binding": "DASHBOARDS", "service": "dashboardsoxxo" }],
  "observability": { "enabled": true }
}
