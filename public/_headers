# Security headers for the app's static files (Cloudflare Workers static
# assets read this file; worker routes like /api and /DashboardsOxxo set
# their own). frame-ancestors 'self': nobody can put the app (and its PIN
# keypad) inside a frame on another site; the Ficha of the Resumen tab is
# same-origin and keeps working.
/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()

# The service worker (notifications only) must not be cached, so a change to
# it reaches phones on the next visit.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The page that creates the notification keys: never cached nor indexed.
/llaves-avisos.html
  Cache-Control: no-store
  X-Robots-Tag: noindex
/llaves-avisos
  Cache-Control: no-store
  X-Robots-Tag: noindex
